<Window x:Class="ValheimWorldSync.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valheim World Sync"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TitleText" Style="{StaticResource HeadingText}" />
        <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Margin="0,12,0,24" />
        <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
