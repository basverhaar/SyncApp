<UserControl x:Class="ValheimWorldSync.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,28,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Setup" Padding="16,6" VerticalAlignment="Top"
                    x:Name="SetupButton" Click="Setup_Click" ToolTip="Change the shared folder, world or your name" />
            <StackPanel>
                <TextBlock x:Name="WorldTitle" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="WorldSubtitle" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Status -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="HostDot" Width="14" Height="14" Margin="0,6,14,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="HostText" Style="{StaticResource HeadingText}" Text="Checking…" />
                    <TextBlock x:Name="SharedText" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <TextBlock x:Name="LocalText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    <TextBlock x:Name="WarningText" Style="{StaticResource BodyText}" Margin="0,8,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Play -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Button x:Name="PlayButton" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                    Height="58" FontSize="19" FontWeight="SemiBold" Content="Play" Click="Play_Click" />
            <TextBlock x:Name="PlayHint" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Activity -->
        <DockPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Activity" Margin="0,0,0,6" />
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" />
        </DockPanel>

        <!-- Footer -->
        <WrapPanel Grid.Row="4" Margin="0,12,0,0">
            <Button Content="Open shared folder" Padding="14,5" Margin="0,0,8,0" Click="OpenShared_Click" />
            <Button Content="Open backups" Padding="14,5" Margin="0,0,8,0" Click="OpenBackups_Click" />
            <Button x:Name="RefreshButton" Content="Refresh" Padding="14,5" Click="Refresh_Click" />
        </WrapPanel>
    </Grid>
</UserControl>
